# Supabase connection — set these in Vercel Dashboard → Settings → Environment Variables
# Get your values from: Supabase → Settings → API
#
# IMPORTANT: Only use the "anon / publishable" key here. Never paste a secret or service-role key.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-publishable-key
